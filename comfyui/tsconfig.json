{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@topview/3d-builder": ["../editor/packages/builder/dist/index.d.ts"],
      "@topview/3d-builder/engine": ["../editor/packages/builder/dist/engine/index.d.ts"],
      "react": ["../editor/packages/builder/node_modules/@types/react"],
      "react/*": ["../editor/packages/builder/node_modules/@types/react/*"],
      "react-dom/*": ["../editor/packages/builder/node_modules/@types/react-dom/*"]
    }
  },
  "include": ["frontend/**/*.tsx"]
}
